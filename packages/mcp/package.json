{
  "name": "@browsersweet/mcp",
  "version": "0.1.0",
  "description": "Local MCP server that gives Claude Code, Claude Desktop, Cursor and other AI agents read-only access to your browser tabs, Spaces, kept links, Archive and handoffs in Browser Sweet, over native messaging.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "browser",
    "browser-tabs",
    "tabs",
    "tab-manager",
    "spaces",
    "arc",
    "arc-browser",
    "browser-extension",
    "chrome-extension",
    "native-messaging",
    "chrome",
    "edge",
    "brave",
    "firefox",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "ai",
    "ai-agents",
    "llm",
    "browsersweet",
    "browser-sweet"
  ],
  "homepage": "https://browsersweet.com/docs/mcp",
  "bugs": {
    "url": "https://github.com/browsersweet/browsersweet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/browsersweet/browsersweet.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "author": {
    "name": "Commune Software",
    "url": "https://www.commune.software"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "browsersweet-mcp": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@browsersweet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "@browsersweet/source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "PROTOCOL.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "node ./scripts/prepack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
