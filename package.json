    "type": "git",
    "url": "git+https://github.com/browsersweet/browsersweet.git"
  },
  "license": "MIT",
  "scripts": {
    "megamono:yalc-publish": "node .megamono/publish-yalc.mjs"
  },
  "private": true,
  "devDependencies": {
    "@content-collections/core": "0.15.2",
    "@eslint/js": "^9.8.0",
    "@megamono/plugin": "0.1.0-next.0",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "^6.3.2",
    "zod": ">=4.1 <5"
  },
  "packageManager": "pnpm@11.24.0",
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    },
    "projectType": "library",
    "tags": [
      "scope:browsersweet",
      "type:util"
    ]
  },
  "dependencies": {}
